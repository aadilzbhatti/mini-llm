<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aadil.mini-llm-tensorboard</string>

    <!-- Live + historical plots for every run under runs/tb (one subdirectory per run id). -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/aadil/dev/wiki-llm</string>
        <string>tensorboard</string>
        <string>--logdir</string>
        <string>/Users/aadil/dev/wiki-llm/runs/tb</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>6006</string>
        <string>--reload_interval</string>
        <string>15</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aadil/dev/wiki-llm</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/aadil/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/aadil/dev/wiki-llm/runner/tensorboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aadil/dev/wiki-llm/runner/tensorboard.log</string>
</dict>
</plist>
